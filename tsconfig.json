{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
			"@/*": ["src/*"],
			"@config/*": ["src/config/*"],
			"@common/*": ["src/common/*"],
      "@prisma/*": ["src/prisma/*"],
      "@sse-sample/*": ["src/sse-sample/*"],
      "@tiers/*": ["src/tiers/*"],
      "@users/*": ["src/users/*"],
		},
  }
}
